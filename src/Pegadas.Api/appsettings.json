{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Pegadas": ""
  },
  "KeyVault": {
    "Uri": ""
  },
  "Jwt": {
    "Issuer": "https://api.pegadas.pt",
    "Audience": "pegadas-app",
    "AccessTokenLifetime": "00:15:00"
  },
  "AppVersion": {
    "MinimumSupported": "1.0.0",
    "Latest": "1.0.0"
  },
  "Workers": {
    "Enabled": true,
    "WorkerCount": 2,
    "PrepareSchema": true
  },
  "Outbox": {
    "PollingInterval": "00:00:02",
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "RateLimiting": {
    "GlobalPerMinute": 600,
    "AuthPerMinute": 10,
    "DeviceBurst": 60,
    "DevicePer10Seconds": 30
  },
  "OpenApi": {
    "Enabled": false
  },
  "Ops": {
    "HangfireDashboard": false
  }
}
